# Supabase project (public, safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, never exposed to the client. Used by the payment gateway
# callback route and admin asset-management helpers.
SUPABASE_SERVICE_ROLE_KEY=

# SATIM payment gateway (CIB / Edahabia). See README for how these are used.
SATIM_MERCHANT_ID=
SATIM_MERCHANT_PASSWORD=
SATIM_API_BASE_URL=https://cib.satim.dz
SATIM_TERMINAL_ID=

# Base URL of this app, used to build the gateway's return/callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
